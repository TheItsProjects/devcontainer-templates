{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Format Slidev",
        "type": "shell",
        "command": "slidev",
        "args": ["format", "${file}"],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "presentation": {
          "reveal": "never"
        },
        "problemMatcher": []
      },
      {
        "label": "Present Slidev",
        "type": "shell",
        "command": "slidev",
        "args": ["${file}", "--remote"],
        "isBackground": true,
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "echo": true,
          "focus": true,
          "clear": false
        },
        "runOptions": {
          "reevaluateOnRerun": false
        },
        "problemMatcher": []
      }
    ]
}
